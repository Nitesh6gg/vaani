# Copy to .env and adjust for your environment. These are consumed as real process
# environment variables (see internal/config/config.go) -- this file is not loaded
# automatically by `go run`/the compiled binary; export it first, e.g.:
#   export $(grep -v '^#' .env | xargs)
# Docker Compose (deploy/docker-compose.yml) does NOT read this file: it sets its
# own values for the static-IP bridge network it creates. This .env is for running
# cmd/server directly against a locally-installed Asterisk.

# ARI REST base URL. The events WebSocket URL is derived from it automatically
# (http -> ws, https -> wss, + /events).
ARI_URL=http://localhost:8088/ari
ARI_USER=vaani
ARI_PASS=vaani
# Stasis application name Asterisk routes calls into (deploy/asterisk/extensions.conf).
ARI_APP=vaani

# Address advertised to Asterisk as externalMedia's external_host. Required,
# never auto-detected -- see the MEDIA_IP decision documented in
# internal/config/config.go. 127.0.0.1 only makes sense when Asterisk and this
# binary run on the same host outside Docker.
MEDIA_IP=127.0.0.1
MEDIA_PORT_BASE=20000
MEDIA_PORT_COUNT=256

# Prometheus /metrics listen address.
METRICS_ADDR=:9091

# Wire byte order of inbound RTP L16 payloads: "le" or "be". Defaults to "le" if
# unset, but that default is unverified until you've actually run
# `go run ./cmd/endianness-check` against a live stack -- until then the server
# logs a startup warning. See docs/AUDIO_PIPELINE.md.
AUDIO_L16_ENDIANNESS=le

# Jitter buffer window size in 20ms packets (1-10; default 3 = 60ms). Also sets
# the priming depth before any real audio is released. See docs/AUDIO_PIPELINE.md.
JITTER_BUFFER_PACKETS=3

# If set, enables per-call debug WAV recording (both directions,
# post-normalization) under this directory. Leave empty to disable.
RECORD_DIR=

# Per-call Handler: "loopback" (default, echoes audio back) or "agent" (Phase 3;
# not implemented yet -- the server refuses to start with this set).
APP_MODE=loopback

# Debug hook: forces every call's Handler to produce zero audio frames, so the
# write tick's silence-fallback path fires on every single tick. Never set this
# in production -- calls carry no audio at all. Leave unset/0 normally.
TEST_SILENT_HANDLER=0
