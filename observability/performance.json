{
  "spec": {
    "display": {
      "name": "Vaani — Go Process & Media Performance",
      "description": "Go-process and media-transport health for Vaani: call volume, Go runtime (goroutines, GC, memory, CPU -- auto-registered by promauto/client_golang), RTP and AudioSocket transport health, jitter buffer, pacer timing, and the ARI control connection. All from Prometheus metrics scraped off :9091/metrics (internal/metrics). Use this to diagnose a call that sounds bad or a process under load; use the AI Pipeline dashboard for STT/LLM/TTS/tool-call behaviour."
    },
    "variables": [],
    "panels": {
      "calls-active": {
        "kind": "Panel",
        "spec": {
          "display": { "name": "Calls Active", "description": "vaani_calls_active" },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": { "timePreference": "global_time" },
              "formatting": { "unit": "none", "decimalPrecision": "0" },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [{ "expression": "last(vaani_calls_active)" }],
                    "disabled": false,
                    "filter": { "expression": "" },
                    "groupBy": [],
                    "order": [],
                    "selectFields": [],
                    "having": { "expression": "" },
                    "functions": [],
                    "legend": "active calls"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "call-duration": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Call Duration (p50 / p95)",
