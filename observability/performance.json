                "spanGaps": { "fillOnlyBelow": false, "fillLessThan": "" }
              },
              "axes": { "softMin": 0, "softMax": 0, "isLogScale": false },
              "legend": { "position": "bottom", "mode": "list", "customColors": null },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [{ "expression": "p50(vaani_call_duration_seconds)" }],
                          "disabled": false,
                          "filter": { "expression": "" },
                          "groupBy": [],
                          "order": [],
                          "selectFields": [],
                          "having": { "expression": "" },
                          "secondaryAggregations": null,
                          "functions": [],
                          "legend": "p50"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [{ "expression": "p95(vaani_call_duration_seconds)" }],
                          "disabled": false,
                          "filter": { "expression": "" },
