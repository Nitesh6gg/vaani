              "visualization": { "timePreference": "global_time", "fillSpans": false },
              "formatting": { "unit": "s", "decimalPrecision": "1" },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
