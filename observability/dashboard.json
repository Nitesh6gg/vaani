{
  "spec": {
    "display": {
      "name": "Vaani — AI Pipeline",
      "description": "Per-service AI pipeline health for Vaani's voice agent: STT/LLM/TTS time-to-first-byte, tool calling, barge-in, and agent-pipeline errors. Built from Prometheus metrics scraped off :9091/metrics (internal/metrics, internal/metrics/agent.go) -- Vaani has no OTel traces; every vaani_* series here is a real counter/histogram already emitted by the Go process, not a log-derived or synthetic value."
    },
    "variables": [],
    "panels": {
      "calls-active": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Calls Active",
            "description": "vaani_calls_active"
          },
          "plugin": {
            "kind": "signoz/NumberPanel",
            "spec": {
              "visualization": { "timePreference": "global_time" },
              "formatting": { "unit": "none", "decimalPrecision": "0" },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "scalar",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [{ "expression": "last(vaani_calls_active)" }],
                    "disabled": false,
                    "filter": { "expression": "" },
                    "groupBy": [],
                    "order": [],
                    "selectFields": [],
                    "having": { "expression": "" },
                    "functions": [],
                    "legend": "active calls"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "agent-turns-time": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Agent Turns Started",
            "description": "Rate of vaani_agent_turns_total -- one per accepted caller transcript, plus LLM-opens-first and caller-silence prompts"
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": { "timePreference": "global_time", "fillSpans": false },
              "formatting": { "unit": "none", "decimalPrecision": "2" },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": { "fillOnlyBelow": false, "fillLessThan": "" }
              },
              "axes": { "softMin": 0, "softMax": 0, "isLogScale": false },
              "legend": { "position": "bottom", "mode": "list", "customColors": null },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "name": "A",
                "plugin": {
                  "kind": "signoz/BuilderQuery",
                  "spec": {
                    "name": "A",
                    "stepInterval": 60,
                    "signal": "metrics",
                    "source": "",
                    "aggregations": [{ "expression": "rate(vaani_agent_turns_total)" }],
                    "disabled": false,
                    "filter": { "expression": "" },
                    "groupBy": [],
                    "order": [],
                    "selectFields": [],
                    "having": { "expression": "" },
                    "functions": [],
                    "legend": "turns/s"
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
      "llm-ttft": {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "LLM Time-to-First-Token (p50 / p95)",
            "description": "vaani_llm_ttft_ms: transcript accepted -> first LLM token. First-token latency matters more than total latency for a voice UI."
          },
          "plugin": {
            "kind": "signoz/TimeSeriesPanel",
            "spec": {
              "visualization": { "timePreference": "global_time", "fillSpans": false },
              "formatting": { "unit": "ms", "decimalPrecision": "0" },
              "chartAppearance": {
                "lineInterpolation": "spline",
                "showPoints": false,
                "lineStyle": "solid",
                "fillMode": "none",
                "spanGaps": { "fillOnlyBelow": false, "fillLessThan": "" }
              },
              "axes": { "softMin": 0, "softMax": 0, "isLogScale": false },
              "legend": { "position": "bottom", "mode": "list", "customColors": null },
              "thresholds": null
            }
          },
          "queries": [
            {
              "kind": "time_series",
              "spec": {
                "plugin": {
                  "kind": "signoz/CompositeQuery",
                  "spec": {
                    "queries": [
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "A",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [{ "expression": "p50(vaani_llm_ttft_ms)" }],
                          "disabled": false,
                          "filter": { "expression": "" },
                          "groupBy": [],
                          "order": [],
                          "selectFields": [],
                          "having": { "expression": "" },
                          "secondaryAggregations": null,
                          "functions": [],
                          "legend": "p50"
                        }
                      },
                      {
                        "type": "builder_query",
                        "spec": {
                          "name": "B",
                          "stepInterval": 60,
                          "signal": "metrics",
                          "source": "",
                          "aggregations": [{ "expression": "p95(vaani_llm_ttft_ms)" }],
                          "disabled": false,
                          "filter": { "expression": "" },
                          "groupBy": [],
                          "order": [],
                          "selectFields": [],
                          "having": { "expression": "" },
                          "secondaryAggregations": null,
                          "functions": [],
                          "legend": "p95"
                        }
                      }
                    ]
                  }
                }
              }
            }
          ],
          "links": []
        }
      },
